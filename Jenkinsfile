pipeline {
    agent any

    stages {
        stage('Deploy with Timeout Protection') {
            steps {
                echo 'Connecting to remote application server...'
                
                // This is the code block generated by your Jenkins utility!
                timeout(time: 10, unit: 'SECONDS') {
                    echo 'Starting file transfers...'
                    // Simulating a fast 3-second upload process
                    sleep time: 3, unit: 'SECONDS'
                    echo 'Upload completed successfully!'
                }
            }
        }
    }
}
